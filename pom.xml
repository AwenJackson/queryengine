<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>io.github.awenjackson</groupId>
    <artifactId>queryengine</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>queryengine</name>
    <description>Embeddable NestQL engine. GraphQL, REST, and NestQL share one runtime. This project does not depend on or include third-party query-engine source.</description>
    <url>https://github.com/awenjackson/queryengine</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>jackson</id>
            <name>jackson</name>
            <email>jackson-miracle@outlook.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/awenjackson/queryengine.git</connection>
        <developerConnection>scm:git:git@github.com:awenjackson/queryengine.git</developerConnection>
        <url>https://github.com/awenjackson/queryengine</url>
        <tag>v0.1.0</tag>
    </scm>

    <modules>
        <module>queryengine-bom</module>
        <module>queryengine-core</module>
        <module>queryengine-dialect-mysql</module>
        <module>queryengine-dialect-dameng</module>
        <module>queryengine-spring-boot-starter</module>
        <module>queryengine-web</module>
        <module>queryengine-boot</module>
        <module>queryengine-demo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-foreign-query-engine</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>*:apijson*</exclude>
                                        <exclude>*:APIJSON*</exclude>
                                        <exclude>com.github.APIJSON:*</exclude>
                                        <exclude>com.github.TommyLemon:*</exclude>
                                        <exclude>io.github.APIJSON:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
